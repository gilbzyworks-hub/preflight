# Supabase (public anon key is fine in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: only this email may sign in (single-user app)
ALLOWED_EMAIL=
# Solana RPC provider URL (data-provider key, NOT a wallet credential). Server-side only.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
